import fs from 'node:fs';
import assert from 'node:assert/strict';
import {createRequire} from 'node:module';
import {pathToFileURL} from 'node:url';
const root=process.cwd(),require=createRequire(root+'/package.json');
const Database=require('better-sqlite3');
const {drizzle}=require('drizzle-orm/better-sqlite3');
const {createJourneyHistory}=await import(pathToFileURL(root+'/src/server/journeyHistory.ts').href);
const {loadStandGroups}=await import(pathToFileURL(root+'/src/calibrator/calibrator.ts').href);
const {percentile}=await import(pathToFileURL(root+'/src/calibrator/shrinkage.ts').href);
const data='/home/gwarren/projects/yale-shuttle-watcher';
const payload=JSON.parse(fs.readFileSync(data+'/red-eta-data/payload.json','utf8'));
const sample=JSON.parse(fs.readFileSync(data+'/history-sample-data/expanded-production-fixture.json','utf8')).historyProbe[0].result;
const db=new Database(data+'/red-eta-data/replay-lap.db',{readonly:true,fileMustExist:true});
const seq=payload.routes['3'];
const net={routes:new Map([[3,{id:3,stops:seq}]]),stops:new Map(Object.entries(payload.stop_names).map(([id,name])=>[Number(id),{name}]))};
const pos={bus:payload.buses.find((b:any)=>b.bus_name==='#308'&&b.route_id===3),sequence:seq,index:seq.indexOf(11),standing:{stopId:11,standingSec:55,approach:false},stopsAhead:3};
const query=createJourneyHistory(db);
const actual=query('Red',48,pos,net,sample.asOf,100);
assert.deepEqual(actual,sample);
const ordinary=query('Red',48,pos,net,sample.asOf);
assert.equal(ordinary.journey.trips.length,24);
const stand=loadStandGroups(drizzle(db),30,sample.asOf).find((g:any)=>g.key==='3:11');
assert.ok(stand);assert.equal(stand.n,230);
const q25=percentile(stand.all,.25),q75=percentile(stand.all,.75);
const report={productionHistoryExactlyMatchesFixture:true,researchTrips:actual.journey.trips.length,researchDates:actual.journey.serviceDates,defaultHistoryTrips:ordinary.journey.trips.length,defaultHistoryDates:ordinary.journey.serviceDates,stand11:{n:stand.n,q10:percentile(stand.all,.1),median:percentile(stand.all,.5),q90:percentile(stand.all,.9),max:Math.max(...stand.all),iqrFences:[q25-1.5*(q75-q25),q75+1.5*(q75-q25)],outsideFences:stand.all.filter((x:number)=>x<q25-1.5*(q75-q25)||x>q75+1.5*(q75-q25)).length}};
fs.writeFileSync('/tmp/red-wide-window-recency-2026-09-17/production-history-check.json',JSON.stringify(report,null,2));console.log(JSON.stringify(report,null,2));db.close();
